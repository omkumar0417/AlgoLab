# AlgoLab Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/algolab?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/algolab?retryWrites=true&w=majority

# Server port (optional, defaults to 3000)
PORT=3000

# Node environment
NODE_ENV=development
